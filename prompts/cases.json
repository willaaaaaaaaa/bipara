            "kind": "sentence",
            "text": "只要审核通过，就发布。"
          }
        ]
      },
      "sample_output": {
        "translations": [
          {
            "unit_id": "t08a",
            "text": "Publish only if the review passes."
          },
          {
            "unit_id": "t08b",
            "text": "If the review passes, publish."
          }
        ]
      },
      "semantic_checks": [
        "The first sentence makes passing necessary: it forbids publishing after a failed review, but does not promise publication after a pass.",
        "The second sentence makes passing sufficient: a pass triggers publication; do not translate it as only if.",
        "Do not merge the two units or turn either implication into if and only if."
      ]
    },
