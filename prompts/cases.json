    {
      "id": "T08-necessary-versus-sufficient",
      "op": "translate",
      "input": {
        "source_language": "zh",
        "target_language": "en",
        "context_before": "",
        "context_after": "",
        "units": [
          {
            "unit_id": "t08a",
