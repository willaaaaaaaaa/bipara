#!/usr/bin/env bash
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
while read -r local_ref local_oid remote_ref remote_oid; do
  case "$local_oid" in 0000000000000000000000000000000000000000) continue ;; esac
  if [ "$remote_oid" = 0000000000000000000000000000000000000000 ]; then
    range="$local_oid"
  else
    range="$remote_oid..$local_oid"
  fi
  python3 "$ROOT/script/check_public_content.py" --root "$ROOT" --commits "$range" --gitleaks
  case "$local_ref" in
    refs/tags/*) python3 "$ROOT/script/check_public_content.py" --root "$ROOT" --tag-ref "$local_ref" --gitleaks ;;
  esac
done
