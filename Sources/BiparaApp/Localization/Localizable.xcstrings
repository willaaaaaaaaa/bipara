        }
      }
    },
    "A deleted configuration can no longer supply a credential for undispatched work. Dispatched requests can finish.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已删除的配置无法再为未派发的工作提供凭据。已发出的请求可以完成。"
