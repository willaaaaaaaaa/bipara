    },
    "The saved request options are incompatible with this protocol. Choose the original protocol or add a new configuration.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存的请求参数与此接口协议不兼容。请选择原接口协议，或添加新配置。"
